# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token

# Gemini AI Studio (free tier subject to quotas)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
LLM_PROVIDER=gemini
BOT_LANGUAGE=fr

# Optional Groq provider settings (used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Optional Vertex provider settings (used when LLM_PROVIDER=vertex)
# VERTEX_API_KEY=
# VERTEX_BASE_URL=https://aiplatform.googleapis.com
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=global
# VERTEX_MODEL=gemini-3.8-flash

# Voice output: Google TTS does not require an API key
TTS_PROVIDER=google

# Bot Settings
BOT_PREFIX=!

# Auto-Join
AUTO_JOIN_VOICE_CHANNELS=true
AUTO_JOIN_MANUAL_LEAVE_COOLDOWN_MS=60000
AUTO_JOIN_RETRY_COOLDOWN_MS=15000

# Conversation Behavior
GLOBAL_REPLY_COOLDOWN_MS=4500
USER_REPLY_COOLDOWN_MS=7000
BOT_ECHO_GUARD_MS=2200
DUPLICATE_TRANSCRIPT_WINDOW_MS=20000
MIN_TRANSCRIPT_CHARS=3
MIN_TRANSCRIPT_WORDS=2
IGNORE_COURTESY_ONLY=true
CHAT_MAX_TOKENS=220
MAX_TTS_CHARS=420
MEMORY_MAX_MESSAGES=24
MEMORY_MAX_CHARS=7000
BOT_WAKE_WORDS=bot,discord bot
TTS_ERROR_NOTIFY_COOLDOWN_MS=60000

# Optional ElevenLabs TTS
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_VOICE_PRESET=balanced
# TTS_PROVIDER=elevenlabs
